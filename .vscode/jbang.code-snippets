  "10-mistral-model": {
    "body": [
      "MistralAiStreamingChatModel streamingChatModel = MistralAiStreamingChatModel.builder()",
      "                .apiKey(System.getenv(\"OVH_AI_ENDPOINTS_ACCESS_TOKEN\"))",
      "                .modelName(System.getenv(\"OVH_AI_ENDPOINTS_MODEL_NAME\"))",
      "                .baseUrl(",
